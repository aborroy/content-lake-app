<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        A shipped connector, not a module of content-lake-app: no parent, absent from the root POM, and
        named in no Dockerfile. Same rules as the connectors beside it.

        This one was an in-tree module group (filesystem/) until #148, which is the whole point of that
        issue: it was the same kind of thing as cmis-connector delivered a more expensive way, costing a
        service image, a Dockerfile stage pair and an opt-in compose profile to do what a jar does.

        maven.compiler.release stays at 21 while the reactor targets 25: this jar is dropped into whatever
        ingester a deployment happens to run.

        Build it standalone, with content-lake-spi installed in the local repository:

            mvn -f ../../pom.xml -pl common/content-lake-spi -am install -DskipTests
            mvn -f pom.xml package
    -->
    <groupId>org.hyland.contentlake</groupId>
    <artifactId>filesystem-connector</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>filesystem-connector</name>
    <description>Content Lake connector plugin for a local or mounted filesystem directory</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <content-lake.version>1.0.0-SNAPSHOT</content-lake.version>
        <spring.version>7.0.8</spring.version>
        <junit.version>5.11.4</junit.version>
        <assertj.version>3.27.3</assertj.version>
    </properties>

    <repositories>
        <repository>
            <id>alfresco-public</id>
            <url>https://artifacts.alfresco.com/nexus/content/groups/public</url>
        </repository>
    </repositories>

    <!--
        No shade plugin, and nothing to shade: this is the only connector whose source needs no client
        library at all, because the source is the filesystem the JDK already talks to. Both dependencies
        below are `provided` and come from the host, so the jar contains this connector's own classes and
        nothing else. Adding a shade execution that bundles nothing would only imply otherwise.
    -->
    <dependencies>
        <dependency>
            <groupId>org.hyland</groupId>
            <artifactId>content-lake-spi</artifactId>
            <version>${content-lake.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ContentSourceClient returns a Spring Resource. Also the host's. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
            <version>${spring.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>filesystem-connector-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>
</project>
